# ============================================================================
# FINDR Environment Configuration Example
# ============================================================================
# Copy this file to .env for local development, or add these keys to
# Streamlit Community Cloud under App Settings -> Secrets (in TOML format).

# 0. Environment Mode (development or production)
# In development: SQLite and local storage are enabled by default.
# In production: Supabase PostgreSQL, Supabase Storage, and a strong access code are strictly required.
FINDR_ENV=development

# 1. Google Gemini AI API Key (Required for AI Analysis & Multimodal Embeddings)
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase PostgreSQL Database (Optional in dev — defaults to local SQLite findr.db if unset)
# From Supabase: Connect -> URI (Session Mode)
# Recommended: Shared Session Pooler (port 5432) with ?sslmode=require
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require

# 3. Supabase Storage & Backend API Credentials
# From Supabase: Project Settings -> API
# IMPORTANT: The private storage bucket requires the backend SERVICE_ROLE key.
# Never expose the service_role key to clients or public logs.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_STORAGE_BUCKET=findr-images

# 4. Exhibition Access Control
# Passcode required for official report submissions, match confirmations, and unredacted contact details.
# In production, must be a strong secret (min 8 characters). 'FINDR2026' is rejected by production validation.
EXHIBITION_ACCESS_CODE=your_strong_private_passcode_here
