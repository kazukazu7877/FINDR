# FINDR Production & Vercel Environment Configuration
# ====================================================

# Gemini AI (Server-side only — NEVER expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here
GENERATION_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Server-side Administration (Required for AI matching and storage access)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=findr-images

# PostgreSQL Pooler Connection (Required for schema migrations / CLI)
DATABASE_URL=postgresql://postgres.your-project-ref:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# App URL
NEXT_PUBLIC_APP_URL=https://findr-campus.vercel.app
